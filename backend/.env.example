# ParcelPilot AI Support Agent — Environment Variables
# Copy this file to .env (same folder) and fill in your actual keys.
# NEVER commit .env to git — it is already in .gitignore.

# ── LLM API Keys ─────────────────────────────────────────────
# Groq (primary LLM) — free tier: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# NVIDIA NIM (fallback LLM) — free tier: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
